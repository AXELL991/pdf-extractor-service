# ============================================
# CONFIGURACIÓN pdf-extractor-service - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- Logging ---
LOGLEVEL=info

# --- Auth interna ---
INTERNAL_API_TOKEN=your-secure-token-here

# --- Límites de extracción (valores del docker-compose) ---
MAX_FILE_SIZE_MB=15
MAX_PAGES=500
EXTRACT_TIMEOUT_SECONDS=25

# --- Pool de procesos (valores del docker-compose) ---
WORKER_POOL_SIZE=1
QUEUE_MAXSIZE=100