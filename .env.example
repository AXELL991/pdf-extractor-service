# ============================================
# CONFIGURACIÓN pdf-extractor-service
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- Logging ---
LOGLEVEL=info

# --- Auth interna ---
INTERNAL_API_TOKEN=tu_token_aqui_cambialo_en_produccion

# --- Límites de extracción ---
MAX_FILE_SIZE_MB=15
MAX_PAGES=500
EXTRACT_TIMEOUT_SECONDS=25

# --- Pool de procesos ---
WORKER_POOL_SIZE=8
QUEUE_MAXSIZE=100
