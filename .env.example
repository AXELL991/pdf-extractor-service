# ============================================
# CONFIGURACIÓN PDF‑EXTRACTOR‑SERVICE - EJEMPLO
# ============================================

# Conexión a MongoDB (servicio docker "mongo")
MONGO_URI=mongodb://mongo:27017/pdf_extractor_db
MONGO_DB_NAME=pdf_extractor_db

# Logging
LOGLEVEL=info

# Puerto interno de la API (solo dentro del contenedor)
API_PORT=8000

# Parámetros de extracción
MAX_FILE_SIZE_MB=5
QUEUE_MAXSIZE=10
WORKER_POOL_SIZE=2
