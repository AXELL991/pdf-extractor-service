# ============================================
# CONFIGURACIÓN pdf-extractor-service - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- Logging ---
# Nivel de logging: debug, info, warning, error
LOGLEVEL=info

# --- Auth interna ---
# Token que deben enviar los servicios downstream en la cabecera X-Internal-Token
# Generar con: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me

# --- Límites de extracción ---
# Tamaño máximo de PDF en megabytes
MAX_FILE_SIZE_MB=10
# Número máximo de páginas a extraer
MAX_PAGES=500
# Timeout en segundos para un job de extracción
EXTRACT_TIMEOUT_SECONDS=60

# --- Pool de procesos ---
# Número de procesos workers (pypdf es CPU-bound)
WORKER_POOL_SIZE=2
# Tamaño máximo de la cola. Si se supera, se responde 429 inmediatamente.
QUEUE_MAXSIZE=10
